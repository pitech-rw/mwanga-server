// use prisma-8

enum UserType {
  admin
  office
  office_manager
  swapper
  agent
  rider
  viewer
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?   @unique
  address      String?
  image        String?
  nationalId   String?   @unique
  passwordHash String?
  lastLoginAt  DateTime?
  type         UserType
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  kycStatus    String    @default("pending")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @onCreate(now()) @onUpdate(now())

  wallet              Wallet?
  nfcCards            NfcCard[]
  assignedBikes       Bike[]
  riderSwaps          SwapTransaction[] @relation("RiderSwap")
  swapsAsSwapper      SwapTransaction[] @relation("SwapperUser")
  reportedViolations  Violation[]       @relation("ViolationReporter")
  offendingViolations Violation[]       @relation("ViolationOffender")
  // Swapper station operator assignment (one station at a time)
  stationId           Int?
  assignedStation     Station?          @relation("StationOperators", fields: [stationId], references: [id])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  users       User[]
  permissions Permission[]
}

model Permission {
  id     Int    @id @default(autoincrement())
  name   String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([roleId, name])
}

enum SwapStatus {
  initiated
  assigned
  collected
  installed
  completed
  failed
  cancelled
  reversed
}

enum PaymentStatus {
  pending
  captured
  failed
  reversed
}

enum ReadingDirection {
  in
  out
}

enum ViolationStatus {
  open
  under_review
  resolved
  dismissed
}

enum ViolationSeverity {
  low
  medium
  high
  critical
}

model Bike {
  id               Int      @id @default(autoincrement())
  plateNumber      String   @unique
  chassisNumber    String?  @unique
  serialNumber     String   @unique
  model            String
  image            String?
  status           String   @default("active")
  userId           Int?
  currentBatteryId  Int?     @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @onCreate(now()) @onUpdate(now())

  user          User?            @relation(fields: [userId], references: [id])
  currentBattery Battery?        @relation("CurrentBattery", fields: [currentBatteryId], references: [id])
  transactions  SwapTransaction[]
}

model Station {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  latitude  Float?
  longitude Float?
  status    String   @default("active")
  capacity  Int      @default(0)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @onCreate(now()) @onUpdate(now())

  batteries    Battery[]
  transactions SwapTransaction[]
  violations   Violation[]
  operators    User[]            @relation("StationOperators")
}

model Battery {
  id              Int      @id @default(autoincrement())
  serialNumber    String   @unique
  manufacturer    String?
  oem             String?
  model           String
  batteryType     String   @default("lithium")
  status          String   @default("available")
  soc             Int      @default(100)
  soh             Int      @default(100)
  cycleCount      Int      @default(0)
  voltage         Float?
  stationId       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @onCreate(now()) @onUpdate(now())

  station             Station?          @relation(fields: [stationId], references: [id])
  bike                Bike?             @relation("CurrentBattery")
  oldSwapTransactions SwapTransaction[] @relation("OldBattery")
  newSwapTransactions SwapTransaction[] @relation("NewBattery")
  readings            BatteryReading[]
}

model NfcCard {
  id           Int      @id @default(autoincrement())
  token        String   @unique
  serialNumber String   @unique
  type         String
  status       String   @default("active")
  userId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())

  user        User?            @relation(fields: [userId], references: [id])
  transactions SwapTransaction[]
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Numeric(10,2)  @default(0)
  currency  String   @default("CDF")
  createdAt DateTime @default(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  user User @relation(fields: [userId], references: [id])
}

model SwapTransaction {
  id                Int           @id @default(autoincrement())
  userId            Int
  bikeId            Int
  stationId         Int
  cardId            Int
  swapperId         Int?
  oldBatteryId      Int?
  newBatteryId      Int?
  status            SwapStatus    @default(initiated)
  paymentStatus     PaymentStatus @default(pending)
  fee               Numeric(10, 2)       @default(0)
  walletBalanceAfter Numeric(10, 2)       @default(0)
  paymentReference  String?
  notes             String?
  assignedAt        DateTime?
  collectedAt       DateTime?
  installedAt       DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @onCreate(now()) @onUpdate(now())

  user         User          @relation("RiderSwap", fields: [userId], references: [id])
  bike         Bike          @relation(fields: [bikeId], references: [id])
  station      Station       @relation(fields: [stationId], references: [id])
  card         NfcCard       @relation(fields: [cardId], references: [id])
  swapper      User?         @relation("SwapperUser", fields: [swapperId], references: [id])
  oldBattery   Battery?      @relation("OldBattery", fields: [oldBatteryId], references: [id])
  newBattery   Battery?      @relation("NewBattery", fields: [newBatteryId], references: [id])
  readings     BatteryReading[]
  ledgerEntries LedgerEntry[]
  auditLogs    AuditLog[]
}

model BatteryReading {
  id                Int              @id @default(autoincrement())
  batteryId         Int
  swapTransactionId Int
  direction         ReadingDirection
  soc               Int
  soh               Int?
  voltage           Float?
  cycleCount        Int?
  recordedAt        DateTime         @default(now())

  battery         Battery         @relation(fields: [batteryId], references: [id])
  swapTransaction SwapTransaction @relation(fields: [swapTransactionId], references: [id])

  @@unique([swapTransactionId, direction])
}

model LedgerEntry {
  id              Int      @id @default(autoincrement())
  swapTransactionId Int
  eventType       String
  amount          Numeric(10, 2)
  description     String?
  createdAt       DateTime @default(now())

  swapTransaction SwapTransaction @relation(fields: [swapTransactionId], references: [id])
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  swapTransactionId Int?
  entityType      String
  entityId        Int?
  actor           String   @default("system")
  action          String
  details         String?
  createdAt       DateTime @default(now())

  swapTransaction SwapTransaction? @relation(fields: [swapTransactionId], references: [id])
}

model Violation {
  id          Int               @id @default(autoincrement())
  trackId     String            @unique
  title       String
  reason      String
  image       String?
  status      ViolationStatus   @default(open)
  severity    ViolationSeverity @default(medium)
  occurredAt  DateTime
  stationId   Int?
  reporterId  Int
  offenderId  Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @onCreate(now()) @onUpdate(now())

  station  Station? @relation(fields: [stationId], references: [id])
  reporter User     @relation("ViolationReporter", fields: [reporterId], references: [id])
  offender User     @relation("ViolationOffender", fields: [offenderId], references: [id])
}
