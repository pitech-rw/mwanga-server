# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
#
# Seed/bootstrap scripts (npm run seed:*, bootstrap:admin) only run when NODE_ENV is
# development or test — never production. The npm scripts set NODE_ENV=development.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Required for JWT auth (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# One-time bootstrap when no users exist (npm run bootstrap:admin)
# BOOTSTRAP_ADMIN_PASSWORD="your-secure-password"
# BOOTSTRAP_ADMIN_USERNAME="admin"
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
