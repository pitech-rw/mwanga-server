# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
#
# Default role permissions sync on server startup.
# npm run bootstrap:admin can run in production and refuses once any user exists.
# Ledger and user-type scripts stay development-only.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Required for JWT auth (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Password reset emails — Zoho SMTP is used when SMTP_* is set; otherwise Resend (RESEND_API_KEY).
# Zoho Mail (smtppro.zoho.com): use an app-specific password if 2FA is enabled.
# SMTP_HOST="smtppro.zoho.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="you@yourdomain.com"
# SMTP_PASS="your-zoho-app-password"
# MAIL_FROM="Mwanga <you@yourdomain.com>"
# Resend (optional fallback when SMTP is not configured)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Mwanga <noreply@yourdomain.com>"
# Public web origin for links in reset emails (Compose dev: http://localhost:5000)
# APP_WEB_URL="http://localhost:5000"

# One-time bootstrap when no users exist (npm run bootstrap:admin)
# BOOTSTRAP_ADMIN_PASSWORD="your-secure-password"
# BOOTSTRAP_ADMIN_USERNAME="admin"
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
